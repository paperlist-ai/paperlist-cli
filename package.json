{
  "name": "@paperlist/cli",
  "version": "0.1.1",
  "description": "Command-line client for the hosted Paperlist MCP server (AI conference papers).",
  "license": "MIT",
  "author": "PaperList",
  "type": "module",
  "bin": {
    "paperlist": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run tests/unit tests/helpers",
    "prepack": "npm run build",
    "pack:smoke": "node scripts/pack-smoke.mjs"
  },
  "homepage": "https://paperlist.ai/en/cli",
  "bugs": {
    "url": "https://github.com/paperlist-ai/paperlist-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paperlist-ai/paperlist-cli.git"
  },
  "keywords": [
    "paperlist",
    "mcp",
    "cli",
    "papers",
    "conferences"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@types/node": "^22.19.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
